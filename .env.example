# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=你的_channel_access_token
LINE_CHANNEL_SECRET=你的_channel_secret

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=你的_openrouter_api_key
OPENROUTER_MODEL=moonshotai/kimi-k2   # optional；預設 moonshotai/kimi-k2

# Fever-bot 設定
SESSION_TTL_SECONDS=1800              # optional；Session 逾時秒數（預設 30 分鐘）
FEVER_DATA_SOURCE=                    # optional；課程資源 .txt 檔路徑（留空用純 LLM 輸出）

# 破冰卡片風格：A（銷售導向）/ B（人格快測）/ C（輕鬆三問）
ICEBREAKER_STYLE=A

# Admin 後台（Basic Auth）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=請改成強密碼
ADMIN_CONFIG_PATH=./admin_config.json      # optional；後台設定 JSON 檔路徑
ADMIN_CORS_ORIGIN=http://localhost:5173    # optional；Vite dev server 來源
